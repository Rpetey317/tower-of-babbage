# Development values only. Copy this file to infra/.env and replace secrets for a deployment.
# The secrets below are valid for the web app's production checks; deployments
# must generate their own (e.g. `openssl rand -base64 32`).
POSTGRES_PASSWORD=babbage
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
LLAMA_BIND_HOST=127.0.0.1
LLAMA_PORT=8080
SHARED_SECRET=uXEQ3GwLEC0knzJH/meUgF7NS704x3PH+Ek7L768BdM=
AUTH_SECRET=QQzg9ZRL+vGFS/CMRHFK1GtJLyhxBi33NuutROj5dkY=
ADMIN_PASSWORD=dev-only-password
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_PIPELINE_WS_URL=ws://localhost:8090
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Provider used by the pipeline service in the `all` profile: `mock` for a
# dependency-free smoke run, `gemini` for the demo/MVP path (needs
# GEMINI_API_KEY), `openai-compat` for the local llama-server path.
PROVIDER=mock
# Required when the pipeline runs with PROVIDER=gemini (demo/MVP path).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Inference endpoint seen by the pipeline container; on the compose network
# this is the llama service, on a remote GPU box its LAN address.
# INFERENCE_URLS=http://llama:8080

# Host-side published ports for the `all` profile (web and pipeline are bound
# to all interfaces so the venue network can reach them).
WEB_BIND_HOST=0.0.0.0
WEB_PORT=3000
PIPELINE_BIND_HOST=0.0.0.0
PIPELINE_PORT=8090

# Gemma 4 E2B Q8_0 with its audio projector is downloaded by llama-server on first run.
LLAMA_MODEL=ggml-org/gemma-4-E2B-it-GGUF:Q8_0
# Used by the automatic CPU fallback when /dev/dri is unavailable.
LLAMA_CPU_MODEL=ggml-org/gemma-4-E2B-it-GGUF:Q4_0
LLAMA_PARALLEL=4
LLAMA_CTX=16384
LLAMA_NGL=99
